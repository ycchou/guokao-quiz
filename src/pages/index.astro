---
import Base from '../layouts/Base.astro';
import { professions } from '../lib/data';
const profs = professions();
const totalQ = profs.reduce((a, p) => a + p.qCount, 0);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '醫事人員國考題庫',
  description: '醫事人員國家考試歷屆試題線上練習平台',
  url: Astro.site?.href,
};
const modes = [
  { href: '/practice', icon: '📝', title: '開始練習', desc: '選年度、考科作答，交卷後核對答案與詳解。' },
  { href: '#banks', icon: '📚', title: '題庫瀏覽', desc: '直接查看歷屆題目與標準答案，可下載原始 PDF。' },
  { href: '/mock', icon: '⏱️', title: '模擬考試', desc: '每科獨立限時，比照實際考試循序作答。' },
];
---

<Base
  title="醫事人員國考題庫｜考選部歷屆試題線上練習．模擬考．答案核對"
  description={`醫事人員國考題庫，涵蓋各醫事職類國家考試（現有護理師、呼吸治療師，持續擴充），收錄考選部歷屆試題共 ${totalQ.toLocaleString()} 題，可線上練習、限時模擬考、瀏覽題庫與答案。`}
  jsonld={jsonld}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-200/40 to-transparent dark:from-slate-900/60"></div>
    <div class="mx-auto max-w-5xl px-4 pt-14 pb-8 sm:pt-20 sm:pb-10 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 px-3 py-1 text-xs font-medium">
        資料來源：考選部考畢試題查詢平臺
      </span>
      <h1 class="font-display mt-5 text-3xl sm:text-5xl font-bold tracking-tight text-brand-900 dark:text-white leading-tight">
        醫事人員國考，<br class="sm:hidden" />歷屆試題練起來
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        專為醫事人員國家考試打造的題庫。收錄 <strong class="text-brand-600 dark:text-brand-400">{totalQ.toLocaleString()}</strong> 題民國 100 年以後歷屆試題，可線上練習、瀏覽題庫、限時模擬考。手機也順手。
      </p>

      <!-- 即時統計 -->
      <div class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-slate-500 dark:text-slate-400">
        <span>今日訪客 <b id="v-today" class="text-slate-800 dark:text-slate-200 tabular-nums">—</b></span>
        <span>累計訪客 <b id="v-total" class="text-slate-800 dark:text-slate-200 tabular-nums">—</b></span>
        <span>全站已作答 <b id="a-total" class="text-slate-800 dark:text-slate-200 tabular-nums">—</b> 題</span>
        <a href="/rankings" class="text-brand-600 hover:underline">錯誤率排行 →</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (async () => {
      const set = (id, n) => { const el = document.getElementById(id); if (el && n != null) el.textContent = Number(n).toLocaleString(); };
      const today = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
      let first = false;
      try { first = localStorage.getItem('gq_visit_day') !== today; } catch (_) {}
      try {
        const res = first ? await fetch('/api/visits', { method: 'POST' }) : await fetch('/api/visits');
        if (res.ok) { const d = await res.json(); set('v-today', d.today); set('v-total', d.total); if (first) try { localStorage.setItem('gq_visit_day', today); } catch (_) {} }
      } catch (_) {}
      try { const r = await fetch('/api/answers'); if (r.ok) { const d = await r.json(); set('a-total', d.answered); } } catch (_) {}
    })();
  </script>

  <!-- 三大模式 -->
  <section class="mx-auto max-w-5xl px-4 pb-4">
    <div class="grid sm:grid-cols-3 gap-4">
      {modes.map((m) => (
        <a href={m.href} class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 hover:border-brand-400 hover:shadow-md transition text-center sm:text-left">
          <div class="text-3xl">{m.icon}</div>
          <h2 class="font-display mt-3 text-xl font-bold text-brand-900 dark:text-white">{m.title}</h2>
          <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{m.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 題庫：選擇職類 -->
  <section id="banks" class="mx-auto max-w-5xl px-4 py-8 scroll-mt-16">
    <h2 class="font-display text-xl font-bold mb-1 text-brand-900 dark:text-white">📚 醫事職類題庫</h2>
    <p class="text-sm text-slate-500 mb-4">選擇職類，瀏覽各年度考科的題目與答案（含原始 PDF 下載）。更多醫事職類持續擴充中。</p>
    <div class="grid sm:grid-cols-2 gap-4">
      {profs.map((p) => (
        <a href={`/${p.slug}`} class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 hover:border-brand-400 hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg font-bold text-brand-900 dark:text-white">{p.name}</h3>
            <span class="text-brand-500 group-hover:translate-x-0.5 transition">→</span>
          </div>
          <div class="mt-3 flex gap-4 text-sm text-slate-500 dark:text-slate-400">
            <span><b class="text-slate-800 dark:text-slate-200">{p.examCount}</b> 場考試</span>
            <span><b class="text-slate-800 dark:text-slate-200">{p.subjectCount}</b> 份考科</span>
            <span><b class="text-slate-800 dark:text-slate-200">{p.qCount.toLocaleString()}</b> 題</span>
          </div>
        </a>
      ))}
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 p-5 flex flex-col justify-center text-slate-400">
        <div class="font-display text-lg font-bold">更多醫事職類</div>
        <p class="mt-1 text-sm">物理治療師、職能治療師、醫事檢驗師、藥師… 陸續新增中。</p>
      </div>
    </div>
  </section>
</Base>
