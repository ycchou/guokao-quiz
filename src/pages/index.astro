---
import Base from '../layouts/Base.astro';
import { professions } from '../lib/data';
const profs = professions();
const totalQ = profs.reduce((a, p) => a + p.qCount, 0);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '國考題庫',
  description: '考選部歷屆國考試題線上練習平台',
  url: Astro.site?.href,
};
---

<Base
  title="國考題庫｜考選部歷屆試題線上練習．模擬考．答案核對"
  description={`免費國考題庫，收錄考選部歷屆試題共 ${totalQ.toLocaleString()} 題（護理師、呼吸治療師），可線上練習、限時模擬考、單科隨機出題，題目與答案完整公開。`}
  jsonld={jsonld}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-brand-200/40 to-transparent dark:from-slate-900/60"></div>
    <div class="mx-auto max-w-5xl px-4 pt-14 pb-10 sm:pt-20 sm:pb-14 text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-100 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 px-3 py-1 text-xs font-medium">
        資料來源：考選部考畢試題查詢平臺
      </span>
      <h1 class="font-display mt-5 text-3xl sm:text-5xl font-bold tracking-tight text-brand-900 dark:text-white leading-tight">
        國考歷屆試題，<br class="sm:hidden" />線上免費練起來
      </h1>
      <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
        收錄 <strong class="text-brand-600 dark:text-brand-400">{totalQ.toLocaleString()}</strong> 題民國 100 年以後歷屆試題，
        可依年度／職類／考科練習並即時核對答案，也能開限時模擬考、單科隨機出題。手機也順手。
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/practice" class="rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold px-6 py-3 shadow-sm transition">開始練習</a>
        <a href="/mock" class="rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:border-brand-400 font-semibold px-6 py-3 transition">模擬考模式</a>
      </div>
    </div>
  </section>

  <!-- Profession picker -->
  <section class="mx-auto max-w-5xl px-4 py-6">
    <h2 class="font-display text-xl font-bold mb-4 text-brand-900 dark:text-white">選擇職類</h2>
    <div class="grid sm:grid-cols-2 gap-4">
      {profs.map((p) => (
        <a href={`/${p.slug}`} class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 hover:border-brand-400 hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg font-bold text-brand-900 dark:text-white">{p.name}</h3>
            <span class="text-brand-500 group-hover:translate-x-0.5 transition">→</span>
          </div>
          <div class="mt-3 flex gap-4 text-sm text-slate-500 dark:text-slate-400">
            <span><b class="text-slate-800 dark:text-slate-200">{p.examCount}</b> 場考試</span>
            <span><b class="text-slate-800 dark:text-slate-200">{p.subjectCount}</b> 份考科</span>
            <span><b class="text-slate-800 dark:text-slate-200">{p.qCount.toLocaleString()}</b> 題</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section class="mx-auto max-w-5xl px-4 py-8">
    <div class="grid sm:grid-cols-3 gap-4">
      {[
        ['📝', '練習＋核對', '選年度、職類、考科作答，交卷後立即看到對錯與正確答案。'],
        ['⏱️', '模擬考試', '比照實際考試限時計時作答，結束後看成績與詳解。'],
        ['🎲', '隨機出題', '挑一個考科、指定近幾年，隨機抽題快速刷題。'],
        ['📌', '錯題本', '答錯自動收錄，隨時回來重做，紀錄存在你的裝置。'],
        ['🔍', '題目搜尋', '關鍵字直接搜尋歷屆考題，找特定觀念超快。'],
        ['🌙', '手機友善', 'RWD 響應式、深色模式，通勤時也能練。'],
      ].map(([icon, t, d]) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5">
          <div class="text-2xl">{icon}</div>
          <h3 class="mt-2 font-bold text-slate-900 dark:text-white">{t}</h3>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400 leading-relaxed">{d}</p>
        </div>
      ))}
    </div>
  </section>
</Base>
