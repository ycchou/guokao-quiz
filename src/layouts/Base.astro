---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  jsonld?: object | object[];
}
const {
  title,
  description = '免費國考題庫：考選部歷屆試題線上練習、模擬考、隨機出題與答案核對，題目與答案完整公開，手機也好用。',
  noindex = false,
  jsonld,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes('國考') || title.includes('題庫') ? title : `${title}｜國考題庫`;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#2E86AB" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <!-- 深色模式：套用前先讀取，避免閃爍 -->
    <script is:inline>
      (() => {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.classList.add('dark');
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-30 border-b border-slate-200/70 dark:border-slate-800 bg-warm/85 dark:bg-slate-950/85 backdrop-blur">
      <nav class="mx-auto max-w-5xl px-4 h-14 flex items-center gap-4">
        <a href="/" class="font-display font-bold text-lg tracking-tight text-brand-900 dark:text-white flex items-center gap-2">
          <span class="inline-grid place-items-center w-7 h-7 rounded-lg bg-brand-600 text-white text-sm font-sans">考</span>
          國考題庫
        </a>
        <div class="hidden sm:flex items-center gap-1 text-sm ml-2">
          <a href="/practice" class="px-3 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">練習</a>
          <a href="/mock" class="px-3 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">模擬考</a>
          <a href="/random" class="px-3 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">隨機出題</a>
          <a href="/records" class="px-3 py-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">紀錄</a>
        </div>
        <div class="ml-auto flex items-center gap-1">
          <a href="/search" aria-label="搜尋題目" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
          </a>
          <button id="theme-toggle" aria-label="切換深色模式" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
            <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 dark:border-slate-800 text-sm text-slate-500 dark:text-slate-400">
      <div class="mx-auto max-w-5xl px-4 py-8 space-y-4">
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          <a href="/nurse" class="hover:text-brand-600">護理師題庫</a>
          <a href="/rt" class="hover:text-brand-600">呼吸治療師題庫</a>
          <a href="/about" class="hover:text-brand-600">關於本站</a>
          <a href="/search" class="hover:text-brand-600">搜尋題目</a>
        </div>
        <div class="rounded-2xl bg-brand-50 dark:bg-slate-900 border border-brand-100 dark:border-slate-800 p-4">
          <p class="text-ink dark:text-slate-200 font-medium">🩺 護理職場透明化運動．姊妹站</p>
          <p class="mt-1 leading-relaxed">
            本題庫站與
            <a href="https://ycchou.github.io/transparent-nursing/" target="_blank" rel="noopener" class="text-brand-600 underline underline-offset-2 hover:text-brand-700">護理職場透明化運動</a>
            同屬照亮護理夥伴職涯的行動：一邊看清職場真相、一邊備好國考戰力。
          </p>
        </div>
        <p class="leading-relaxed">
          本站試題與答案來源為
          <a href="https://wwwq.moex.gov.tw/exam/wFrmExamQandASearch.aspx" rel="nofollow noopener" target="_blank" class="underline hover:text-brand-600">考選部考畢試題查詢平臺</a>
          （政府公開資料）。本站僅整理供免費練習之用，非官方網站；答案以考選部公告之標準答案／更正答案為準。
        </p>
      </div>
    </footer>

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const el = document.documentElement;
        el.classList.toggle('dark');
        localStorage.setItem('theme', el.classList.contains('dark') ? 'dark' : 'light');
      });
      // PWA：正式環境註冊 service worker（離線可用）
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
